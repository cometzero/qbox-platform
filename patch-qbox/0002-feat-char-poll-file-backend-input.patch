From 93aa8fe12c77b4d04fbbc9ec1fd9d2c89e26c4d2 Mon Sep 17 00:00:00 2001
Message-ID: <93aa8fe12c77b4d04fbbc9ec1fd9d2c89e26c4d2.1783003606.git.parkch98@gmail.com>
From: Chanho Park <parkch98@gmail.com>
Date: Wed, 1 Jul 2026 20:04:13 +0900
Subject: [PATCH] feat(char): poll file backend input

Allow char_backend_file to keep polling a read file instead of treating
initial EOF as the permanent end of input. This supports FIFO-like host
console input where the writer may appear after simulation start.

The implementation opens the input non-blocking when polling is enabled,
uses a small host thread to enqueue new bytes, and joins that thread at
simulation shutdown and destruction.

Signed-off-by: Chanho Park <parkch98@gmail.com>
---
 .../include/char_backend_file.h               | 90 ++++++++++++++++++-
 1 file changed, 89 insertions(+), 1 deletion(-)

diff --git a/systemc-components/backends/char_backend_file/include/char_backend_file.h b/systemc-components/backends/char_backend_file/include/char_backend_file.h
index 3a880808673c..c7b152c93161 100644
--- a/systemc-components/backends/char_backend_file/include/char_backend_file.h
+++ b/systemc-components/backends/char_backend_file/include/char_backend_file.h
@@ -21,8 +21,17 @@
 #include <ports/biflow-socket.h>
 #include <module_factory_registery.h>
 
+#include <atomic>
+#include <chrono>
+#include <cerrno>
 #include <queue>
+#include <stdio.h>
 #include <stdlib.h>
+#include <thread>
+#ifndef _WIN32
+#include <fcntl.h>
+#include <unistd.h>
+#endif
 #include <scp/report.h>
 class char_backend_file : public sc_core::sc_module
 {
@@ -30,10 +39,14 @@ protected:
     cci::cci_param<std::string> p_read_file;
     cci::cci_param<std::string> p_write_file;
     cci::cci_param<unsigned int> p_baudrate;
+    cci::cci_param<bool> p_poll_read;
+    cci::cci_param<unsigned int> p_poll_interval_ms;
 
 private:
     FILE* r_file = nullptr;
     FILE* w_file = nullptr;
+    std::atomic_bool m_poll_running = false;
+    std::thread m_poll_thread;
     double delay;
     SCP_LOGGER();
 
@@ -51,6 +64,8 @@ public:
         , p_read_file("read_file", "", "read file path")
         , p_write_file("write_file", "", "write file path")
         , p_baudrate("baudrate", 0, "number of bytes per second")
+        , p_poll_read("poll_read", false, "poll read_file instead of sending EOF at initial end of file")
+        , p_poll_interval_ms("poll_interval_ms", 1, "polling interval for poll_read in milliseconds")
         , socket("biflow_socket")
     {
         SCP_TRACE(()) << "constructor";
@@ -67,9 +82,27 @@ public:
     void start_of_simulation()
     {
         if (!p_read_file.get_value().empty()) {
-            r_file = fopen(p_read_file.get_value().c_str(), "r");
+#ifndef _WIN32
+            if (p_poll_read.get_value()) {
+                int fd = open(p_read_file.get_value().c_str(), O_RDONLY | O_NONBLOCK);
+                if (fd >= 0) {
+                    r_file = fdopen(fd, "r");
+                    if (r_file == NULL) {
+                        close(fd);
+                    }
+                }
+            } else
+#endif
+            {
+                r_file = fopen(p_read_file.get_value().c_str(), "r");
+            }
 
             if (r_file == NULL) SCP_ERR(()) << "Error opening the input file " << p_read_file.get_value() << ".\n";
+            if (r_file != NULL && p_poll_read.get_value()) {
+                set_nonblocking(r_file);
+                m_poll_running = true;
+                m_poll_thread = std::thread(&char_backend_file::poll_read_thread, this);
+            }
             update_event.notify(sc_core::SC_ZERO_TIME);
         }
 
@@ -83,13 +116,31 @@ public:
     }
     void end_of_elaboration() {}
 
+    void set_nonblocking(FILE* file)
+    {
+#ifndef _WIN32
+        int fd = fileno(file);
+        int flags = fcntl(fd, F_GETFL, 0);
+        if (flags >= 0) {
+            fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+        }
+#else
+        (void)file;
+#endif
+    }
+
     void rcv_thread()
     {
         if (p_baudrate.get_value() == 0)
             delay = 0;
         else
             delay = (1.0 / p_baudrate.get_value());
+        if (p_poll_read.get_value()) {
+            return;
+        }
         char c;
+        if (r_file == nullptr) sc_core::wait(update_event);
+        if (r_file == nullptr) return;
         while (fread(&c, sizeof(char), 1, r_file) == 1) {
             socket.enqueue(c);
             sc_core::wait(delay, sc_core::SC_SEC);
@@ -99,6 +150,31 @@ public:
         r_file = nullptr;
     }
 
+    void poll_read_thread()
+    {
+#ifndef _WIN32
+        const unsigned int poll_ms = p_poll_interval_ms.get_value() == 0 ? 1 : p_poll_interval_ms.get_value();
+        char buffer[256];
+        while (m_poll_running) {
+            if (r_file == nullptr) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(poll_ms));
+                continue;
+            }
+            ssize_t count = read(fileno(r_file), buffer, sizeof(buffer));
+            if (count > 0) {
+                for (ssize_t i = 0; i < count; ++i) {
+                    socket.enqueue(buffer[i]);
+                }
+                continue;
+            }
+            if (count < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+                SCP_ERR(()) << "Error reading the input file " << p_read_file.get_value() << ".\n";
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(poll_ms));
+        }
+#endif
+    }
+
     void writefn(tlm::tlm_generic_payload& txn, sc_core::sc_time& t)
     {
         uint8_t* data = txn.get_data_ptr();
@@ -111,8 +187,20 @@ public:
         fflush(w_file);
     }
 
+    void stop_poll_thread()
+    {
+        m_poll_running = false;
+        if (m_poll_thread.joinable()) {
+            m_poll_thread.join();
+        }
+    }
+
+    void end_of_simulation() { stop_poll_thread(); }
+
     ~char_backend_file()
     {
+        stop_poll_thread();
+
         if (w_file != NULL) {
             fclose(w_file);
         }
-- 
